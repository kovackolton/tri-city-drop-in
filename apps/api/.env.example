DATABASE_URL=postgresql://tricity:local-development-only@localhost:5432/dropin
PORT=3000
WEB_ORIGIN=http://localhost:4200
FIREBASE_PROJECT_ID=
# Local emulator only; never set in production:
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Optional Resend Free worker; disabled by default. See docs/resend-email-notifications.md.
EMAIL_ENABLED=false
EMAIL_DELIVERY_MODE=preview
EMAIL_FROM=no_reply@contact.tricitiesdropin.com
# Set an explicit UTC rollout timestamp before enabling; do not email historical notifications.
# EMAIL_NOTIFICATIONS_START_AT=2026-12-01T00:00:00.000Z
EMAIL_BATCH_SIZE=50
EMAIL_SEND_INTERVAL_MS=1100
EMAIL_DAILY_LIMIT=100
EMAIL_MONTHLY_LIMIT=3000
EMAIL_PREVIEW_DIR=email-previews
# EMAIL_REPLY_TO=your-monitored-support@example.com
# Store RESEND_API_KEY in Secret Manager; only the worker needs it. Preview needs no key.
